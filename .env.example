# Copy to .env (chmod 600 .env). Never commit .env.

# --- LLM (job matching / cover letters) ---------------------------------------
# Anthropic API key (llm.provider: anthropic). Without it, the rule-based scorer is used
# and every job in the report is labelled with the scoring method.
ANTHROPIC_API_KEY=
# For llm.provider: openai_compatible, set llm.api_key_env in settings.yaml to this name.
# OPENAI_COMPATIBLE_API_KEY=

# --- Candidate mailbox (read-only job alerts + application confirmations) ------
# Enable sources.email_alerts in settings.yaml. For Gmail use an App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your login password.
IMAP_USERNAME=
IMAP_PASSWORD=

# --- Optional overrides of config/settings.yaml --------------------------------
# RESUME_PATH="/absolute/path/to/resume.pdf"
# JOB_AUTOMATION_DATA_ROOT=~/Job_Applications
# APPLICATION_MODE=APPROVAL_REQUIRED
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5

# =============================================================================
# Web portal (docker compose). deploy/start.sh creates .env with random secrets
# on first run; edit the values below as needed.
# =============================================================================
POSTGRES_PASSWORD=change-me-long-random
# >= 32 random characters. Changing it signs everyone out.
JWT_SECRET=change-me-at-least-32-random-characters
# Fernet key for encrypting users' IMAP app passwords (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=
# The backend is reachable from the internet through ngrok: require an invite code to register.
REGISTRATION_INVITE_CODE=
# Browser origins allowed to call the API (GitHub Pages site + local UI).
# The last entry is the Fill with JobPilot browser extension (its ID is fixed by the key in extension/manifest.json).
CORS_ORIGINS=https://yadava-krishna.github.io,http://localhost:3000,chrome-extension://ehpfmhhbnijflgagkpdbhiakldmgedgp

# Brute-force protection: per client address (per minute) and per account (failures in a window).
AUTH_RATE_LIMIT_PER_MINUTE=10
LOGIN_FAILURES_PER_ACCOUNT=10
LOGIN_FAILURE_WINDOW_MINUTES=15
# X-Forwarded-For is honoured only from these proxy networks (ngrok/nginx containers, this machine).
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12
# API docs (/api/v1/docs): local = only from this machine (default in Docker) | public | off
DOCS_MODE=local

# Ports on this machine. The backend binds to localhost only; the local UI to all interfaces (LAN mode).
BACKEND_PORT=8000
BACKEND_BIND=127.0.0.1
FRONTEND_PORT=3000
FRONTEND_BIND=0.0.0.0

# ngrok tunnel (HTTPS backend URL for the GitHub Pages frontend)
NGROK_AUTHTOKEN=
# Optional free static domain from https://dashboard.ngrok.com/domains (keeps the URL stable)
NGROK_DOMAIN=

# AI scoring in the portal: rule_based | anthropic (uses ANTHROPIC_API_KEY above)
PORTAL_LLM_PROVIDER=rule_based
PORTAL_LLM_MODEL=claude-opus-5
# Optional official Adzuna Jobs API (https://developer.adzuna.com/) for automated discovery.
# Put your own app ID/key in .env only (never in this file or in git). Leave empty to disable the source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Daily discovery for all onboarded users (Asia/Kolkata)
SCHEDULER_RUN_TIME=09:00

# GitHub Pages deployment (deploy/deploy_frontend.sh)
PAGES_REPO=git@github.com:yadava-krishna/Job_portal.git
PAGES_SSH_KEY=~/.ssh/id_ed25519_difinative
PAGES_URL=https://yadava-krishna.github.io/Job_portal/
