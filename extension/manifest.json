{
  "manifest_version": 3,
  "name": "Fill with JobPilot",
  "short_name": "JobPilot",
  "version": "1.0.0",
  "description": "Fills Greenhouse, Lever and Ashby application forms from your JobPilot profile when you click Fill. You review and submit yourself.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://job-boards.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.eu.greenhouse.io/*",
    "https://boards.eu.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_title": "Fill with JobPilot",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
}
